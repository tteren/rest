{
    "name": "app/slim-service",
    "description": "A minimal service application built with Slim Framework",
    "type": "project",
    "require": {
        "php": ">=8.4.27",
        "slim/psr7": "1.8.0",
        "slim/slim": "4.15.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "start": "php -S 127.0.0.1:8080 -t public public/index.php"
    }
}
